<Project>
  <!-- 全仓统一编译设置。每个库只写自己的 Compile 列表与 PackageReference。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarnOn>3390;1182</WarnOn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DebugType>portable</DebugType>
    <!-- 中央包管理下显式引用 FSharp.Core，否则测试可执行文件拿不到它。 -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>
  <!-- 交付物：每个库打成一个包，供组合者以干净消费方式使用（./x pack）。 -->
  <PropertyGroup>
    <PackageId>Wanxiang2.$(MSBuildProjectName)</PackageId>
    <IsPackable>false</IsPackable>
    <IsPackable Condition="$(MSBuildProjectDirectory.Contains('/libs/')) And !$(MSBuildProjectDirectory.Contains('/tests'))">true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>
</Project>
