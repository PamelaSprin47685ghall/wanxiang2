<?xml version="1.0" encoding="utf-8"?>
<!-- wanxiang2 自己的 NuGet 源配置：Wanxiang2.* 只从 ./x pack 产出的本地 feed 取。
     本仓库因此不再依赖任何父目录的 NuGet 配置独立 restore（旧仓库根的 NuGet.config 已随其退役删除）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local"><package pattern="Wanxiang2.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
