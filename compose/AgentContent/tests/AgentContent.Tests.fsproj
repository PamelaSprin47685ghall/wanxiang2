<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 原样迁自旧仓库的测试保持原文以便对照。 -->
    <NoWarn>$(NoWarn);FS0025;FS1182;FS0064</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Scenario.fs" />
    <Compile Include="GoldenTests.fs" />
    <Compile Include="AgentCoverageMessageTests.fs" />
    <Compile Include="ProductizationMessageTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Wanxiang2.AppConfig" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Wire" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Anthropic" VersionOverride="0.0.0-local" />
    <ProjectReference Include="../AgentContent.fsproj" />
  </ItemGroup>
</Project>
