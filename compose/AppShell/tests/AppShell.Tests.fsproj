<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <Compile Include="Headless.fs" />
    <Compile Include="Rig.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="ComposerTests.fs" />
    <Compile Include="JourneyAttachmentTests.fs" />
    <Compile Include="DraftSaveGateTests.fs" />
    <Compile Include="ExpiryDeletionTests.fs" />
    <Compile Include="A11yTraversalTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- 到期真删的判据要落在**服务端存储**上：同一条删除命令能否把对话从事件存储里删掉。 -->
    <PackageReference Include="Wanxiang2.ChatDomain" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.EventStore" VersionOverride="0.0.0-local" />
    <ProjectReference Include="../AppShell.fsproj" />
  </ItemGroup>
</Project>
