<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：ChatScroller + ExchangeNav + ChatEmpty + SkeletonList + ScrollFollow + ScrollTween + ExchangeJump + BreathPhase + ChatEmptyText + Theme = 旧 Views/ChatView.fs 的滚动区、空态、骨架与问答跳转。协作者见 PackageReference。 -->
  <ItemGroup>
    <Compile Include="Looks.fs" />
    <Compile Include="ChatPane.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Wanxiang2.ChatScroller" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ExchangeNav" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatEmpty" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.SkeletonList" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ScrollFollow" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ScrollTween" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ExchangeJump" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BreathPhase" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatEmptyText" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.SpacingRamp" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Theme" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemePalette" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemeMetrics" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MotionSwitch" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.IconSet" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.DesignRhythm" VersionOverride="0.0.0-local" />
  </ItemGroup>
</Project>
