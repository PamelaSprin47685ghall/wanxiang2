<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：ComposerBox + AttachmentTray + ModelChip + ComposerSendState + ModelVision + Theme = 旧 Views/Composer.fs。协作者见 PackageReference。 -->
  <ItemGroup>
    <Compile Include="Looks.fs" />
    <Compile Include="ComposerDesk.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Wanxiang2.ComposerBox" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AttachmentTray" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ModelChip" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.BusyRing" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ComposerSendState" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ModelVision" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ComposerDrafts" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MediaTypes" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MessageView" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Theme" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemePalette" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemeMetrics" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MotionSwitch" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.IconSet" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.DesignRhythm" VersionOverride="0.0.0-local" />
  </ItemGroup>
</Project>
