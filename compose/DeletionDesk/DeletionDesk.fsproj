<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：删除即撤销（旧 AppShell.ScheduleDelete / ArmDeleteTimer / CommitDelete）。协作者：PendingDeletion、CommandFeedback、Outbox（按命令登记）、Wire。命名空间沿用 Wanxiang.UI。 -->
  <ItemGroup>
    <Compile Include="DeletionDesk.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Wanxiang2.Wire" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.PendingDeletion" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CommandFeedback" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Outbox" VersionOverride="0.0.0-local" />
  </ItemGroup>
</Project>
