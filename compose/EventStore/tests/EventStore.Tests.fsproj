<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 原样迁自旧仓库的测试：旧仓库不把未用值、不完整匹配当错误，这里保持原文以便对照。 -->
    <NoWarn>$(NoWarn);FS0025;FS1182</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="EventLogTests.fs" />
    <Compile Include="StoreConsistencyTests.fs" />
    <Compile Include="ReplayTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../EventStore.fsproj" />
  </ItemGroup>
</Project>
