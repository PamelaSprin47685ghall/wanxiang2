    <PackageReference Include="Wanxiang2.MessageMenu" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MessageView" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolCallState" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolOverview" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ToolSummary" VersionOverride="0.0.0-local" />
