<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：把 MessageView 折成各消息卡控件库的数据并拼成一张卡，外观由主题管理者的活实例填。协作者：RevealPane、FoldHeader、BusyRing、ThinkingBlock、ToolCallCard、AttachmentChip、ActionStrip、ErrorPanel、UserBubble、StreamCaret、UsageFoot、MarkdownView、ReadingLook、CopyButton、CountdownTicker、CardReconcile、CaretBreath、MessageMenu、MessageView、ToolCallState、ToolOverview、ToolSummary、ToolArgsPreview、ToolErrorSummary、DurationText、MessageTimestamp、GenerationErrorTitle、ErrorRecovery、ConversationRuns、Wire、Theme、IconSet、DesignRhythm。 -->
  <ItemGroup>
    <Compile Include="Looks.fs" />
    <Compile Include="Card.fs" />
    <Compile Include="Deck.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Wanxiang2.UiKit" VersionOverride="0.0.0-local" />
