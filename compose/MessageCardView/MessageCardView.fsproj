    <PackageReference Include="Wanxiang2.ErrorPanel" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.UserBubble" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.StreamCaret" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.UsageFoot" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MarkdownView" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ReadingLook" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CodeTint" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CopyButton" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.CountdownTicker" VersionOverride="0.0.0-local" />
