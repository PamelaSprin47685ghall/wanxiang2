<Project Sdk="Microsoft.NET.Sdk">
  <!-- 金样生成器：引用旧仓库构建出的 Wanxiang.UI 及其依赖（OldBin = 旧 tests/Wanxiang.Tests/bin/Debug/net10.0） -->
  <PropertyGroup><OutputType>Exe</OutputType><OldBin Condition="'$(OldBin)' == ''">MISSING</OldBin><TargetFramework>net10.0</TargetFramework><TreatWarningsAsErrors>false</TreatWarningsAsErrors><ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../tests/Samples.fs" />
    <Compile Include="../../tests/Dump.fs" />
    <Compile Include="../../tests/MathHtml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <OldDll Include="$(OldBin)/*.dll" Exclude="$(OldBin)/Avalonia*.dll;$(OldBin)/xunit*.dll;$(OldBin)/Microsoft.*.dll;$(OldBin)/System.*.dll;$(OldBin)/Wanxiang.Tests.dll;$(OldBin)/FSharp.Core.dll;$(OldBin)/SkiaSharp*.dll;$(OldBin)/HarfBuzzSharp*.dll;$(OldBin)/MicroCom*.dll" />
    <Reference Include="@(OldDll)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>
</Project>
