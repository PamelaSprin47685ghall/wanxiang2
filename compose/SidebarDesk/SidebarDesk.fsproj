<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：旧 Views/Sidebar.fs 的协作部分。界面在 SidebarBrand、SidebarSearch、ConversationRows、ListEmptyCard、BatchBar、HostSwitcher。 -->
