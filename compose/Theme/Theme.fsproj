<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：主题管理者。协作者：ThemePalette、ThemeMetrics、MotionSwitch、ThemeTween、SpacingRamp、ColorBlend（悬停叠色）、ThemeFonts（内嵌字体）。 -->
  <ItemGroup>
    <Compile Include="Live.fs" />
    <Compile Include="ThemeManager.fs" />
    <Compile Include="ThemeStyles.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Wanxiang2.ThemePalette" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemeMetrics" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.MotionSwitch" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ColorBlend" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.SpacingRamp" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ThemeFonts" VersionOverride="0.0.0-local" />
  </ItemGroup>
</Project>
