<Project Sdk="Microsoft.NET.Sdk">
  <!-- 组合者：客户端连接与观察状态。协作者：TextSocket（按代文本传输）、CommitTimeline（按 commitId 的消息列表操作）、
       AguiWire（AG-UI 编解码）、ChatDomain（提交行与领域事件）。命名空间沿用旧仓库 Wanxiang.Client。 -->
  <ItemGroup>
    <Compile Include="WsClient.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Wanxiang2.CommitTimeline" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.AguiWire" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.ChatDomain" VersionOverride="0.0.0-local" />
    <PackageReference Include="Wanxiang2.Wire" VersionOverride="0.0.0-local" />
  </ItemGroup>
</Project>
