<?xml version="1.0" encoding="utf-8"?>
<!-- 组合者只消费交付包：Wanxiang2.* 只从 ./x pack 产出的本地源取。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../artifacts/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local"><package pattern="Wanxiang2.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
