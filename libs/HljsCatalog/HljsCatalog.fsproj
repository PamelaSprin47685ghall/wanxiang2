<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="HljsCatalog.fs" />
    <Compile Include="RichScripts.fs" />
  </ItemGroup>
  <!-- 脚本走清单资源，逻辑名与旧 Wanxiang.UI 相同（js/…）。 -->
  <ItemGroup>
    <EmbeddedResource Include="js/**">
      <LogicalName>js/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
