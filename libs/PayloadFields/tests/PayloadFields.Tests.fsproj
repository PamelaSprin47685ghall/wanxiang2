<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 原样迁自旧仓库的测试保持原文以便对照。 -->
    <NoWarn>$(NoWarn);FS0025;FS1182;FS0064</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../PayloadFields.fsproj" />
  </ItemGroup>
</Project>
